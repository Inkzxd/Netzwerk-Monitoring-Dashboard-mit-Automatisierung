# Example environment configuration for local development
# Copy this file to .env and adjust values as needed.
# The real .env file is excluded from version control.

# Grafana admin credentials
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-grafana-password

# Application admin credentials
APP_ADMIN_USER=admin
APP_ADMIN_PASSWORD=change-me-application-password

# Secret used to authenticate Alertmanager webhook requests
ALERTMANAGER_WEBHOOK_SECRET=change-me-alert-secret